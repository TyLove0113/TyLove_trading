# ===== TyLove Trading 環境變數 =====
# 複製呢個檔案做 .env，填入你自己嘅值。永遠唔好 commit .env 上 GitHub。

# Telegram 通知（必填）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 新聞分析用（可留空，留空就只靠關鍵詞規則）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===== 交易參數（可以照用預設）=====
ACCOUNT_SIZE_HKD=100000
RISK_PER_TRADE_PCT=1.0
MAX_OPEN_POSITIONS=3
MAX_POSITION_PCT=30
DAILY_LOSS_LIMIT_PCT=3

ATR_STOP_MULT=1.5
ATR_TARGET1_MULT=2.0
ATR_TARGET2_MULT=3.0

ALERT_THRESHOLD=70
WATCH_THRESHOLD=58
MIN_TURNOVER_HKD=50000000

# ===== 排程 =====
SCAN_TIMES=09:25,10:30,11:30,14:00
MONITOR_INTERVAL_MIN=15
CLOSE_REMINDER_TIME=15:50

# ===== 網頁登入（留空 = 免登入，公開部署強烈建議設定）=====
DASH_USER=
DASH_PASS=

# ===== 資料庫（Railway 請指向 volume 掛載路徑，例如 /data/tylove.db）=====
# DB_PATH=/data/tylove.db

# ================= 黃金 XAU/USD（v3 新增）=================
# 唔想用黃金功能就設 0
GOLD_ENABLED=1
# 數據源代號（yfinance 冇 XAUUSD 現貨，用 COMEX 黃金期貨做代理）
GOLD_SYMBOL=GC=F
GOLD_LABEL=XAU/USD
# MT4 實測點差（美元／盎司）
GOLD_SPREAD_USD=0.30
# 你嘅手數範圍
GOLD_LOT_MIN=0.01
GOLD_LOT_MAX=0.05
# 掃描時段（香港時間）—— 覆蓋倫敦開市、紐約開市
GOLD_SCAN_TIMES=15:05,16:05,17:05,20:35,21:35,22:35,23:35
# 黃金專用 Telegram bot（去 BotFather 開一個新 bot）
TELEGRAM_GOLD_BOT_TOKEN=
TELEGRAM_GOLD_CHAT_ID=

# ================= 時區（強烈建議加）=================
# 令容器本身都用香港時間，做雙重保險
TZ=Asia/Hong_Kong
